config_version=5

[application]
config/name="东方夜行符"
run/main_scene="res://scenes/battle.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
boot_splash/bg_color=Color(0.05, 0.04, 0.1, 1)
boot_splash/show_image=false

[autoload]
G="*res://scripts/core/game.gd"

[display]
window/size/viewport_width=270
window/size/viewport_height=480
window/size/window_width_override=540
window/size/window_height_override=960
window/stretch/mode="viewport"
window/stretch/aspect="keep_width"
window/handheld/orientation=1

[gui]
theme/custom_font="res://assets/fonts/fusion12.ttf"
theme/default_font_size=12

[input_devices]
pointing/emulate_touch_from_mouse=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true
environment/defaults/default_clear_color=Color(0.05, 0.04, 0.1, 1)
